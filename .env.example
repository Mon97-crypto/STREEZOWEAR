# ─── Public (safe in the browser) ────────────────────────────────
# Canonical site URL, used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://streezowear.vercel.app
# Keep "false" until launch: adds noindex to every page while content is being finalised.
NEXT_PUBLIC_SITE_INDEXABLE=false

# ─── Phase 3: Supabase ───────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only — never prefix with NEXT_PUBLIC_
# ADMIN_EMAIL=                       # first admin, provisioned by scripts/admin-provision

# ─── Phase 4: Razorpay / email / shipping ────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RESEND_API_KEY=
# SHIPROCKET_API_EMAIL=
# SHIPROCKET_API_PASSWORD=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
